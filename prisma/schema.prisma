// Prisma schema for zin-in-padel
// Replaces data/db.json + data/padelclubs_vlaanderen.json.
// Values for fields like gender/preferredSide/matchPreference/activeFlow are
// validated at the app layer — Postgres uses TEXT (no DB enums).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* -------------------------------------------------------------------------- */
/*  Users                                                                     */
/* -------------------------------------------------------------------------- */

model User {
  id                 String   @id
  manageToken        String   @unique
  referralCode       String?  @unique
  waId               String   @unique
  phone              String
  profileName        String
  firstName          String?
  lastName           String?
  optedIn            Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  onboardingStep     Int?
  activeFlow         String?
  pendingFriendName  String?
  gender             String?
  level              Int?
  preferredSide      String?
  playsBothSides     Boolean  @default(false)
  matchPreference    String?
  matchLevelMin      Int?
  matchLevelMax      Int?
  createdAt          DateTime
  updatedAt          DateTime

  favorites        UserFavorite[]
  preferredClubs   UserPreferredClub[]
  messages         Message[]
  organizedMatches Match[]             @relation("MatchOrganizer")
  referralsMade    ReferralAttribution[] @relation("ReferralInviter")
  referralReceived ReferralAttribution?  @relation("ReferralReferred")
}

model Player {
  ref   String @id
  name  String
  phone String

  favoritedBy      UserFavorite[]
  invitedToMatches MatchInvitedPlayer[]
}

model UserFavorite {
  userId    String
  playerRef String
  /** Per-user nickname for this friend. Decoupled from the shared Player/User name. */
  name      String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerRef], references: [ref], onDelete: Cascade)

  @@id([userId, playerRef])
  @@index([playerRef])
}

model UserPreferredClub {
  userId String
  clubId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

model ReferralAttribution {
  id             String    @id
  campaignSlug   String
  inviterId      String
  referredUserId String    @unique
  status         String    @default("pending")
  attributedAt   DateTime
  qualifiedAt    DateTime?
  disqualifiedAt DateTime?

  inviter      User @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@unique([campaignSlug, inviterId, referredUserId])
  @@index([campaignSlug, status, qualifiedAt])
  @@index([inviterId])
  @@index([attributedAt])
}

/* -------------------------------------------------------------------------- */
/*  Waitlist (landing-page viability signups)                                 */
/* -------------------------------------------------------------------------- */

model WaitlistSignup {
  id                 String   @id
  phone              String   @unique
  tvMemberId         Int
  clubId             String?
  consent            Boolean
  consentAt          DateTime @default(now())
  consentTextVersion String   @default("waitlist-v1")
  createdAt          DateTime
  updatedAt          DateTime

  member TvMember @relation(fields: [tvMemberId], references: [id])
  club   Club?    @relation(fields: [clubId], references: [id])

  @@index([createdAt])
  @@index([tvMemberId])
  @@index([clubId])
}

/* -------------------------------------------------------------------------- */
/*  Matches                                                                   */
/* -------------------------------------------------------------------------- */

model Match {
  id                           String   @id
  organizerId                  String
  clubId                       String?
  scheduledAt                  DateTime?
  durationMinutes              Int      @default(90)
  format                       String
  totalSlots                   Int      @default(4)
  fallbackToLevelRange         Boolean  @default(false)
  fallbackLevelMin             Int?
  fallbackLevelMax             Int?
  fallbackLevelDelayMinutes    Int      @default(30)
  fallbackToEveryone           Boolean  @default(false)
  fallbackEveryoneDelayMinutes Int      @default(60)
  currentCascadePhase          Int      @default(0)
  nextCascadeAt                DateTime?
  status                       String
  createdAt                    DateTime
  updatedAt                    DateTime

  organizer      User                 @relation("MatchOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  club           Club?                @relation(fields: [clubId], references: [id])
  clubs          MatchClub[]
  invitedPlayers MatchInvitedPlayer[]
  confirmedSlots MatchConfirmedSlot[]

  @@index([organizerId])
  @@index([clubId])
  @@index([nextCascadeAt])
}

model MatchClub {
  matchId String
  clubId  String

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club  Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([matchId, clubId])
  @@index([clubId])
}

model MatchInvitedPlayer {
  matchId      String
  playerRef    String
  token        String   @unique
  status       String   @default("pending")
  cascadePhase Int      @default(1)
  sentAt       DateTime?
  respondedAt  DateTime?
  sendAttempts Int      @default(0)
  sendError    String?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerRef], references: [ref], onDelete: Cascade)

  @@id([matchId, playerRef])
  @@index([playerRef])
  @@index([matchId, status])
}

model MatchConfirmedSlot {
  matchId String
  idx     Int
  name    String

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, idx])
}

/* -------------------------------------------------------------------------- */
/*  WhatsApp templates (Twilio Content API / Meta approval)                   */
/* -------------------------------------------------------------------------- */

model WhatsAppTemplate {
  id                String    @id
  friendlyName      String
  contentSid        String?   @unique
  whatsappName      String?
  category          String    @default("UTILITY")
  approvalStatus    String    @default("draft")
  rejectionReason   String?
  contentSourcePath String?
  lastSyncedAt      DateTime?
  createdAt         DateTime
  updatedAt         DateTime
}

/* -------------------------------------------------------------------------- */
/*  Messages                                                                  */
/* -------------------------------------------------------------------------- */

model Message {
  id        String   @id
  userId    String
  body      String
  direction String
  at        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

/* -------------------------------------------------------------------------- */
/*  Games                                                                     */
/* -------------------------------------------------------------------------- */

model Game {
  id          String   @id
  title       String
  scheduledAt DateTime
  status      String
}

/* -------------------------------------------------------------------------- */
/*  Clubs (catalog — replaces data/padelclubs_vlaanderen.json)                */
/* -------------------------------------------------------------------------- */

model Club {
  id       String  @id
  name     String
  city     String
  province String?

  padelstatsClubId   Int?
  padelstatsSyncedAt DateTime?
  tvClubId           Int?
  tvSyncedAt         DateTime?

  playtomicAliases      ClubPlaytomicAlias[]
  preferredBy           UserPreferredClub[]
  matches               Match[]
  matchLocations        MatchClub[]
  padelstatsMemberships ClubPadelstatsMembership[]
  tvMemberships         ClubTvMembership[]
  waitlistSignups       WaitlistSignup[]

  @@index([padelstatsClubId])
}

model PadelstatsMember {
  id            Int      @id
  name          String
  gender        String
  currentRank   Int
  predictedRank Int
  subCategory   String
  createdAt     DateTime
  updatedAt     DateTime

  clubMemberships ClubPadelstatsMembership[]

  @@index([name])
}

model ClubPadelstatsMembership {
  clubId             String
  padelstatsMemberId Int
  importedAt         DateTime

  club   Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member PadelstatsMember @relation(fields: [padelstatsMemberId], references: [id], onDelete: Cascade)

  @@id([clubId, padelstatsMemberId])
  @@index([padelstatsMemberId])
}

model TvMember {
  id            Int      @id
  name          String
  gender        String
  padelRanking  String?
  currentRank   Int
  subCategory   String
  createdAt     DateTime
  updatedAt     DateTime

  clubMemberships ClubTvMembership[]
  waitlistSignups WaitlistSignup[]

  @@index([name])
}

model ClubTvMembership {
  clubId     String
  tvMemberId Int
  importedAt DateTime

  club   Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member TvMember @relation(fields: [tvMemberId], references: [id], onDelete: Cascade)

  @@id([clubId, tvMemberId])
  @@index([tvMemberId])
}

model ClubPlaytomicAlias {
  clubId         String
  alias          String
  aliasNormalized String

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, alias])
  @@index([aliasNormalized])
}
