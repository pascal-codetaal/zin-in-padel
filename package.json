{
  "name": "zin-in-padel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "prisma generate && react-router build",
    "postinstall": "prisma generate",
    "dev": "react-router dev",
    "worker:start": "tsx scripts/worker.ts",
    "mastra:dev": "NODE_OPTIONS='--dns-result-order=ipv4first' mastra dev --dir app/lib/mastra --env .env --request-context-presets presets.json",
    "start": "node scripts/start-server.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:repair-checksums": "tsx scripts/repair-migration-checksums.ts",
    "db:migrate:deploy:direct": "sh -c 'DATABASE_URL=\"$DIRECT_URL\" prisma migrate deploy'",
    "db:push": "prisma db push",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:users:cleanup": "tsx scripts/seed-users.ts --cleanup",
    "presets:sync": "tsx scripts/sync-presets.ts",
    "clubs:padelstats": "tsx scripts/fetch-club-members-padelstats.ts",
    "clubs:padelstats:test": "tsx scripts/fetch-club-members-padelstats.ts --club-id 8221",
    "clubs:padelstats:all": "tsx scripts/fetch-club-members-padelstats.ts --all --quiet -j 6 --delay 300 -o data/all-club-members.json",
    "clubs:padelstats:retry": "tsx scripts/fetch-club-members-padelstats.ts --retry-errors --quiet -j 3 --delay 500",
    "clubs:padelstats:import": "tsx scripts/import-club-members-padelstats.ts",
    "members:sync-tv": "tsx scripts/sync-tv-members-from-padelstats.ts",
    "clubs:tv": "tsx scripts/fetch-club-members-tv.ts",
    "clubs:tv:test": "tsx scripts/fetch-club-members-tv.ts --club-id 8041",
    "clubs:tv:all": "tsx scripts/fetch-club-members-tv.ts --all -j 2 -o data/all-club-members-tv.json",
    "clubs:tv:all:padel": "tsx scripts/fetch-club-members-tv.ts --all --padel-only -j 2 -o data/all-club-members-tv.json",
    "clubs:tv:retry": "tsx scripts/fetch-club-members-tv.ts --retry-errors -j 1",
    "clubs:tv:import": "tsx scripts/import-club-members-tv.ts",
    "members:analyze": "tsx scripts/analyze-member-coverage.ts",
    "members:search:test": "tsx scripts/test-member-search.ts",
    "templates:seed": "tsx scripts/seed-whatsapp-templates.ts",
    "templates:sync": "tsx scripts/sync-whatsapp-templates.ts",
    "templates:register": "tsx scripts/register-whatsapp-template.ts",
    "test:pascal-invites-joris": "sh -c 'set -a; . ./.env; set +a; tsx scripts/setup-pascal-invites-joris.ts'",
    "test:joris-invites-pascal": "sh -c 'set -a; . ./.env; set +a; tsx scripts/setup-joris-invites-pascal.ts'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "bullmq": "^5.58.5",
    "@mastra/core": "^1.36.0",
    "@mastra/memory": "^1.19.0",
    "@mastra/pg": "^1.11.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@vercel/react-router": "^1.3.0",
    "isbot": "^5.1.36",
    "pg": "^8.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.1",
    "twilio": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "mastra": "^1.10.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.7"
  }
}
