TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OPENAI_API_KEY=

# Supabase Postgres — Project Settings → Database → Connection string
# App / serverless (Transaction pooler, port 6543, ?pgbouncer=true):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations need a direct connection (Session pooler or direct, port 5432).
# Run once with: DATABASE_URL="$DIRECT_URL" npm run db:migrate:deploy
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# One-time SQLite import source (npm run db:copy-sqlite)
SQLITE_DATABASE_URL="file:./data/app.db"

VITE_SUPABASE_URL=https://xopjvbfkxpewveptfesv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
