# Account SID starts with AC… (Console → Account Info). Not the API key SID (SK…).
TWILIO_ACCOUNT_SID=
# Primary Auth Token for that account — not the API key secret.
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 (see Twilio Console → WhatsApp sandbox)
TWILIO_WHATSAPP_FROM=
# Local only: public tunnel URL for Twilio signature validation (omit on Vercel — uses request URL).
# TWILIO_WEBHOOK_URL=https://padelbot-dev.loca.lt/webhooks/twilio/whatsapp
# TWILIO_VALIDATE_SIGNATURE=false
# TWILIO_MOCK=true
# Optional: Messaging Service SID (recommended for Content template sends)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
OPENAI_API_KEY=

# Supabase Postgres — Project Settings → Database → Connection string
# Copy the pooler HOSTNAME from the dashboard (region varies, e.g. aws-0-eu-west-3, not always eu-central-1).
# App / serverless (transaction pooler, port 6543, user postgres.<PROJECT_REF>):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations: session pooler (port 5432) or direct db.<project>.supabase.co:5432 (IPv6 locally).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: override Mastra memory storage (defaults to DATABASE_URL). Use a direct URL.
# MASTRA_MEMORY_DB_URL=

# One-time SQLite import source (npm run db:copy-sqlite)
SQLITE_DATABASE_URL="file:./data/app.db"

# Mastra Studio presets (pnpm presets:sync) — basis-URL voor persoonlijke links in tools
APP_ORIGIN=http://localhost:5173

# Invite send queue backend (BullMQ + Redis). Set to "true" to enqueue
# invites and process them in the dedicated worker process.
# INVITE_QUEUE_ENABLED=false
# Redis URL for BullMQ. Upstash provides a rediss:// URL.
# BULLMQ_REDIS_URL=
# Optional aliases also supported by queue.server.ts:
# UPSTASH_REDIS_URL=
# REDIS_URL=

# Worker tuning (optional)
# SEND_WORKER_CONCURRENCY=10
# PHASE_WORKER_CONCURRENCY=5

# Shared secret for /api/cron/cascade-tick and /api/cron/send-tick.
# Required in production. Supabase pg_cron jobs call with
# Authorization: Bearer ${CRON_SECRET}. Locally, leave unset to allow
# unauthenticated dev calls (NODE_ENV !== 'production').
# CRON_SECRET=

# Real-Twilio test scripts — phones used by:
#   pnpm test:pascal-invites-joris
#   pnpm test:joris-invites-pascal
# Must be E.164 (with leading +) and joined to the Twilio sandbox.
TEST_PASCAL_PHONE=
TEST_JORIS_PHONE=

VITE_SUPABASE_URL=https://xopjvbfkxpewveptfesv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
