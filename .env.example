TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 (see Twilio Console → WhatsApp sandbox)
TWILIO_WHATSAPP_FROM=
# Public URL Twilio POSTs to (required for signature check with localtunnel/ngrok)
# TWILIO_WEBHOOK_URL=https://padelbot-dev.loca.lt/webhooks/twilio/whatsapp
# TWILIO_VALIDATE_SIGNATURE=false
# TWILIO_MOCK=true
OPENAI_API_KEY=

# Supabase Postgres — Project Settings → Database → Connection string
# App / serverless (Transaction pooler, port 6543, ?pgbouncer=true):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations: direct connection (port 5432), NOT the transaction pooler (6543).
# Easiest: copy DATABASE_URL when it already uses db.<project>.supabase.co:5432.
# Pooler session mode must use user postgres.<PROJECT_REF>, not postgres alone.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional: override Mastra memory storage (defaults to DATABASE_URL). Use a direct URL.
# MASTRA_MEMORY_DB_URL=

# One-time SQLite import source (npm run db:copy-sqlite)
SQLITE_DATABASE_URL="file:./data/app.db"

# Mastra Studio presets (pnpm presets:sync) — basis-URL voor persoonlijke links in tools
APP_ORIGIN=http://localhost:5173

VITE_SUPABASE_URL=https://xopjvbfkxpewveptfesv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
