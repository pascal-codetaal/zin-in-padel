# Account SID starts with AC… (Console → Account Info). Not the API key SID (SK…).
TWILIO_ACCOUNT_SID=
# Primary Auth Token for that account — not the API key secret.
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 (see Twilio Console → WhatsApp sandbox)
TWILIO_WHATSAPP_FROM=
# Local only: public tunnel URL for Twilio signature validation (omit on Vercel — uses request URL).
# TWILIO_WEBHOOK_URL=https://padelbot-dev.loca.lt/webhooks/twilio/whatsapp
# TWILIO_VALIDATE_SIGNATURE=false
# TWILIO_MOCK=true
OPENAI_API_KEY=

# Supabase Postgres — Project Settings → Database → Connection string
# Copy the pooler HOSTNAME from the dashboard (region varies, e.g. aws-0-eu-west-3, not always eu-central-1).
# App / serverless (transaction pooler, port 6543, user postgres.<PROJECT_REF>):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations: session pooler (port 5432) or direct db.<project>.supabase.co:5432 (IPv6 locally).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: override Mastra memory storage (defaults to DATABASE_URL). Use a direct URL.
# MASTRA_MEMORY_DB_URL=

# One-time SQLite import source (npm run db:copy-sqlite)
SQLITE_DATABASE_URL="file:./data/app.db"

# Mastra Studio presets (pnpm presets:sync) — basis-URL voor persoonlijke links in tools
APP_ORIGIN=http://localhost:5173

VITE_SUPABASE_URL=https://xopjvbfkxpewveptfesv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
